# ---- App ----
PORT=3000
# Nhieu origin cach nhau dau phay
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ---- MongoDB ----
# MongoDB cai tren may (hoac MongoDB Atlas). Khong ket noi duoc thi tu bat MongoDB nhung (luu o backend/.mongo-data).
MONGO_URI=mongodb://127.0.0.1:27017/voucher_platform
# true: luon dung MongoDB nhung, khong thu MONGO_URI
USE_EMBEDDED_MONGO=false
# Tu nap du lieu mau khi CSDL con trong
AUTO_SEED=true

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m

# ---- OTP ----
# Login OTP: fixed 5-minute expiry, 60-second resend, 5 attempts per challenge.
# Generate a private random secret of at least 32 characters. Never expose to Vite.
OTP_SECRET=

# ---- Email ----
# OTP login requires SMTP. Console mode never returns or prints login codes.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# De trong thi dung "Voucher Platform <SMTP_USER>"
EMAIL_FROM=
# SMTP_PASSWORD and SMTP_FROM remain accepted as legacy aliases.

# ---- Thanh toan VNPAY Sandbox ----
# Khong dua VNPAY_HASH_SECRET vao frontend hay commit file .env that.
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Return URL la trang frontend; IPN URL HTTPS public can gui cho VNPAY.
VNPAY_RETURN_URL=http://localhost:5173/payment-return
VNPAY_IPN_URL=
VNPAY_VERSION=2.1.0
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret
# true: cho phep nut "Thanh toan thu (demo)" (POST /api/orders/:id/simulate-payment)
PAYMENT_SIMULATOR=false

# ---- Giu cho / hoan tien ----
ORDER_RESERVATION_TTL_MINUTES=15
REFUND_WINDOW_DAYS=7
REFUND_MIN_DAYS_BEFORE_EXPIRE=3
# auto: goi cong hoan tien; manual: moi yeu cau du dieu kien vao hang doi quan tri
REFUND_MODE=auto
# Cong hoan tien gia lap: success | declined | unavailable (quan tri vien doi duoc tren web, khong can khoi dong lai)
REFUND_SANDBOX_RESULT=success

# ---- Su dung voucher ----
REDEEM_TOKEN_TTL_SECONDS=60
REDEEM_HMAC_SECRET=change_me_redeem_hmac_secret
REDEEM_TOKEN_MAX_PER_WINDOW=10
REDEEM_TOKEN_RATE_WINDOW_MINUTES=10
REDEEM_OTP_MAX_FAILS=5
REDEEM_OTP_FAIL_WINDOW_MINUTES=5
REDEEM_OTP_LOCK_MINUTES=15
BILL_EDIT_WINDOW_MINUTES=10

# ---- Hoa hong mac dinh ----
DEFAULT_COMMISSION_RATE=0.1
